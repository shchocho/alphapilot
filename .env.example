# AlphaPilot 환경 설정 견본. 이 파일을 .env로 복사해서 값을 채운다. .env는 저장소에 올리지 않는다.
# 비밀값은 여기(서버)에만 두고, 화면에서는 입력받지도 보여주지도 않는다.

# ── 서버(운영에서 필수) ──────────────────────────────────────────────
# 접속할 도메인. DNS가 이 서버의 공인 IP를 가리켜야 HTTPS 인증서가 발급된다.
AP_DOMAIN=trade.example.com
# 서버가 받아들일 Host. 보통 AP_DOMAIN과 같게 둔다(쉼표로 여러 개).
AP_ALLOWED_HOSTS=trade.example.com
# 인증 앱 비밀값을 암호화하는 키의 재료. 한 번 정하면 바꾸지 않는다(바꾸면 로그인 등록을 다시 해야 한다).
#   만들기: python -c "import secrets; print(secrets.token_urlsafe(48))"
AP_SECRET_KEY=
# 처음 관리자 등록 화면에서 한 번 입력하는 값. 등록을 마친 뒤에는 지워도 된다.
#   만들기: python -c "import secrets; print(secrets.token_urlsafe(24))"
AP_SETUP_TOKEN=

# ── AI 위원회 ───────────────────────────────────────────────────────
# 비워 두면 AI 위원회는 판단하지 못하고 새 매수를 모두 보류한다(자동매매 화면에서 규칙 위원회로 바꿀 수 있다).
ANTHROPIC_API_KEY=

# ── 키움증권 REST API ───────────────────────────────────────────────
# 모의투자 키와 실전 키는 서로 다르다. 모의투자부터 넣고 연결을 확인한다. 안내: docs/kiwoom-setup.md
KIWOOM_MOCK_APP_KEY=
KIWOOM_MOCK_SECRET_KEY=
KIWOOM_LIVE_APP_KEY=
KIWOOM_LIVE_SECRET_KEY=
# 실전 전환 잠금. true가 아니면 화면에서 어떤 조작을 해도 실전으로 바꿀 수 없다.
ALLOW_LIVE_TRADING=false

# ── 시세 데이터 ─────────────────────────────────────────────────────
# naver: 네이버 금융의 공개 일봉(비공식 통로). sample: 화면 확인용 가짜 데이터.
AP_DATA_PROVIDER=naver

# ── 개발용(내 PC에서 돌릴 때) ───────────────────────────────────────
# AP_ENV=dev 이면 HTTPS가 아니어도 로그인 쿠키가 동작하고, AP_SECRET_KEY·AP_SETUP_TOKEN 없이도 켜진다.
# AP_ENV=dev
# AP_DATA_DIR=./data
